# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Optional: Override default settings
MAX_RESULTS=50
REQUEST_TIMEOUT=10
TZ=UTC

# Logging configuration (for Docker)
LOG_LEVEL=INFO
LOG_FILE=/app/logs/bot.log

# Chrome/Selenium configuration
CHROME_HEADLESS=true
CHROME_OPTIONS=--no-sandbox,--disable-dev-shm-usage,--disable-gpu

# Get your bot token from @BotFather on Telegram
# Visit: https://t.me/botfather

# Default values (you don't need to change these unless you want to override):
# BOT_TOKEN: Required - your Telegram bot token
# MAX_RESULTS: 50 - maximum number of search results
# REQUEST_TIMEOUT: 10 - timeout for HTTP requests in seconds
# TZ: UTC - timezone for timestamps
# LOG_LEVEL: INFO - logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_FILE: /app/logs/bot.log - log file path
# CHROME_HEADLESS: true - run Chrome in headless mode
# CHROME_OPTIONS: --no-sandbox,--disable-dev-shm-usage,--disable-gpu - Chrome options
#
# Default values are set in docker-compose.yml if not specified here
# BOT_TOKEN is required - no default value
